# No environment variables are required to run or deploy this app.
#
# Optional: canonical / Open Graph URL for a custom domain.
# On Vercel the production URL is detected automatically (VERCEL_PROJECT_PRODUCTION_URL).
NEXT_PUBLIC_SITE_URL=

# Reserved for a future server-side try-on model. The current build is local-only:
# uploads never leave the browser, so these can stay unset.
TRYON_API_URL=
TRYON_API_KEY=
